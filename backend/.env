# Optional credentials for gated NASA Earthdata and Copernicus services.
# Keyless datasets (NASA POWER, Planetary Computer Landsat/Sentinel-2/NASADEM/MODIS) work without these.

EARTHDATA_TOKEN=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
CDS_API_KEY=

# Local API cache lifetime in hours
CACHE_TTL_HOURS=24
